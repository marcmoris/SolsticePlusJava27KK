<!-- ============================================= -->
<!-- Tools                                         -->
<!-- ============================================= -->
<!-- $Header: /cvsrepo/solsticev7/tools/build.xml,v 1.2 2007/07/19 15:28:58 marmor01 Exp $ -->

<project name="tools" default="toolsDistribution" basedir=".">

  <description>
	The resulting CCTools.jar and CSTools.jar 
	repackage all third party libraries
	in a single jar for simplified start and version control.
	The resuling Server CSTools.jar is added to EARs
  </description>

  <!-- set global properties for this build -->
  <property name="src" value="Src"/>
  <property name="build.dir" value="build"/>
  <property name="buildClient.dir" value="build/Client"/>
  <property name="buildServer.dir" value="build/Server"/>
  <property name="buildWAS.dir" value="build/WAS"/>
  <property name="buildPG.dir" value="build/PostgreSQL"/>
  <property name="buildOracle.dir" value="build/Oracle"/>
  <property name="buildDB2.dir" value="build/DB2"/>
  <!--<property name="buildMSSQL.dir" value="build/MSSQL2005"/>-->
  <property name="buildTDS.dir" value="build/MSSQL"/>
  <property name="dist.dir" value="../lib"/>
  <property environment="env"/>

  <!-- set path to include the necessary jar files for javac -->
  <path id="project.class.path">
    <pathelement path="${classpath}"/>
    <pathelement path="lib/jstl.jar"/>
    <pathelement path="lib/jsp-api.jar"/>
    <pathelement path="lib/servlet-api.jar"/>
    <pathelement path="lib/standard.jar"/>
    <pathelement path="lib/jnlp.jar"/>
  </path>


  <!-- ============================================= -->
  <!-- Init                                          -->
  <!-- ============================================= -->
  <target name="toolsInit"
	description="initialization target">
    <echo message="=========== Build Tools  ${env.COMPIERE_VERSION}"/>
    <!-- create the time stamp -->
    <tstamp/>
    <!-- create the build directory structure used by compile -->
    <mkdir dir="${build.dir}"/>
    <mkdir dir="${buildClient.dir}"/>
    <mkdir dir="${buildServer.dir}"/>
    <mkdir dir="${buildWAS.dir}"/>
    <mkdir dir="${buildOracle.dir}"/>
    <mkdir dir="${buildPG.dir}"/>
    <mkdir dir="${buildDB2.dir}"/>
    <!--    <mkdir dir="${buildMSSQL.dir}"/> -->
    <mkdir dir="${buildTDS.dir}"/>
    <!-- check for the distribution directory -->
    <mkdir dir="${dist.dir}"/>

    <condition property="jars.uptodate">
      <and>
        <uptodate targetfile="${dist.dir}/CCTools.jar">
          <srcfiles dir="${src}" includes="**/*.java"/>
        </uptodate>
        <available file="${dist.dir}/postgreSQL.jar"/>
        <available file="${dist.dir}/db2.jar"/>
        <available file="${dist.dir}/sqlServer.jar"/>
        <available file="${dist.dir}/oracle.jar"/>
      </and>
    </condition>
  </target>


  <!-- ============================================= -->
  <!-- Compile ECS                                   -->
  <!-- ============================================= -->
  <target name="toolsCompile" depends="toolsInit" unless="jars.uptodate">
    <!-- compile the java code from ${src} into ${build.dir}S -->
    <javac srcdir="${src}" 
    	destdir="${build.dir}" deprecation="on" debug="on" encoding="ISO-8859-1">
      <classpath refid="project.class.path"/>
    </javac>
    <!-- copy all image & sound files from src to the build directory -->
    <copy todir="${build.dir}">
      <fileset dir="${src}">
		<include name="**/images/*"/>
		<include name="**/*.gif"/>
		<include name="**/*.jpg"/>
		<include name="**/*.wav"/>
		<include name="**/*.htm"/>
		<include name="**/*.html"/>
		<include name="**/*.properties"/>
		<exclude name="**/package.html"/>
      </fileset>
    </copy>
  </target>


  <!-- ============================================= -->
  <!-- Buld Apps Server Client Jars                  -->
  <!-- ============================================= -->
  <target name="toolsAppsServer" depends="toolsCompile" 
  	unless="jars.uptodate"
	description="Create WAS Client jar">
    
    <!-- WAS Client - only requires j2ee client and it is actually 
         from sun			-->
    <unjar src="lib/j2ee.jar" dest="${buildWAS.dir}" overwrite="no"/>
    <unjar src="lib/sunRowset.jar" dest="${buildWAS.dir}" overwrite="yes"/>
    <!-- Clean up			-->
    <delete>
      <fileset dir="${buildWAS.dir}" includes="build.xml"/>
      <fileset dir="${buildWAS.dir}/META-INF" casesensitive="no" includes="*.mf,*.sf,*.rsa,*.dsa"/>
    </delete>
    <!-- Create ibmWAS.jar file 	-->
    <jar jarfile="${dist.dir}/ibmWAS.jar">
      <fileset dir="${buildWAS.dir}"/>
      <manifest>
		<attribute name="Specification-Title" value="Compiere WAS Client"/>
		<attribute name="Specification-Version" value="${env.COMPIERE_VERSION}"/>
		<attribute name="Specification-Vendor" value="(C) 2006 ComPiere, Inc."/>
		<attribute name="Implementation-Title" value="WAS ${env.COMPIERE_VERSION}"/>
		<attribute name="Implementation-Version" value="${env.COMPIERE_VERSION} ${DSTAMP}-${TSTAMP}"/>
		<attribute name="Implementation-Vendor" value="${env.COMPIERE_VENDOR}"/>
		<attribute name="Implementation-URL" value="http://www.compiere.com"/>
		<attribute name="Permissions" value="all-permissions"/>
      </manifest>
    </jar>
  </target>

  <!-- ============================================= -->
  <!-- Buld Database Jars                            -->
  <!-- ============================================= -->
  <target name="toolsDatabase" depends="toolsCompile" 
	  	unless="jars.uptodate"
		description="Create db jars">

    <!-- PostgreSQL Lib		-->
    <unjar src="lib/edb-jdbc14.jar" dest="${buildPG.dir}"/>
    <!-- Clean up			-->
    <delete>
      <fileset dir="${buildPG.dir}" includes="build.xml"/>
      <fileset dir="${buildPG.dir}/META-INF" casesensitive="no" includes="*.mf,*.sf,*.rsa,*.dsa"/>
    </delete>

    <!-- Create postgreSQL.jar file 	-->
    <jar jarfile="${dist.dir}/postgreSQL.jar">
      <fileset dir="${buildPG.dir}"/>
      <manifest>
		<attribute name="Specification-Title" value="PostgreSQL JDBC"/>
		<attribute name="Specification-Version" value="8.1.5.21"/>
		<attribute name="Specification-Vendor" value="EnterpriseDB"/>
		<attribute name="Implementation-Title" value="edb ${env.COMPIERE_VERSION}"/>
		<attribute name="Implementation-Version" value="${env.COMPIERE_VERSION} ${DSTAMP}-${TSTAMP}"/>
		<attribute name="Implementation-Vendor" value="${env.COMPIERE_VENDOR}"/>
		<attribute name="Implementation-URL" value="http://www.compiere.org"/>
		<attribute name="Permissions" value="all-permissions"/>
      </manifest>
    </jar>
  	
  	
    <!-- Oracle Lib			-->
    <unjar src="lib/ojdbc14.jar" dest="${buildOracle.dir}"/>
    <unjar src="lib/ocrs12.jar" dest="${buildOracle.dir}"/>
    <!-- Clean up			-->
    <delete>
      <fileset dir="${buildOracle.dir}" includes="build.xml"/>
      <fileset dir="${buildOracle.dir}/META-INF" casesensitive="no" includes="*.mf,*.sf,*.rsa,*.dsa"/>
    </delete>

    <!-- Create oracle.jar file 	-->
    <jar jarfile="${dist.dir}/oracle.jar">
      <fileset dir="${buildOracle.dir}"/>
      <manifest>
		<attribute name="Specification-Title" value="Oracle JDBC"/>
		<attribute name="Specification-Version" value="10g"/>
		<attribute name="Specification-Vendor" value="Oracle"/>
		<attribute name="Implementation-Title" value="oracle ${env.COMPIERE_VERSION}"/>
		<attribute name="Implementation-Version" value="${env.COMPIERE_VERSION} ${DSTAMP}-${TSTAMP}"/>
		<attribute name="Implementation-Vendor" value="${env.COMPIERE_VENDOR}"/>
		<attribute name="Implementation-URL" value="http://www.compiere.org"/>
		<attribute name="Permissions" value="all-permissions"/>
      </manifest>
    </jar>

  	
    <!-- DB/2 Lib		-->
    <unjar src="lib/db2jcc.jar" dest="${buildDB2.dir}">
		<patternset>
			<exclude name="COM/**"/>
		</patternset>
    </unjar>
    <unjar src="lib/db2jcc_license_cu.jar" dest="${buildDB2.dir}"/>
    <!-- Clean up			-->
    <delete>
      <fileset dir="${buildDB2.dir}" includes="build.xml"/>
      <fileset dir="${buildDB2.dir}/META-INF" casesensitive="no" includes="*.mf,*.sf,*.rsa,*.dsa"/>
    </delete>

    <!-- Create db2.jar file 	-->
    <jar jarfile="${dist.dir}/db2.jar">
      <fileset dir="${buildDB2.dir}"/>
      <manifest>
		<attribute name="Specification-Title" value="DB/2 JDBC"/>
		<attribute name="Specification-Version" value="8.2"/>
		<attribute name="Specification-Vendor" value="IBM"/>
		<attribute name="Implementation-Title" value="ibm ${env.COMPIERE_VERSION}"/>
		<attribute name="Implementation-Version" value="${env.COMPIERE_VERSION} ${DSTAMP}-${TSTAMP}"/>
		<attribute name="Implementation-Vendor" value="${env.COMPIERE_VENDOR}"/>
		<attribute name="Implementation-URL" value="http://www.compiere.org"/>
		<attribute name="Permissions" value="all-permissions"/>
      </manifest>
    </jar>

    <!-- Create sqlServer.jar file 	-->

    <!-- jTDS Lib				-->
    <unjar src="lib/jtds-1.0.jar" dest="${buildTDS.dir}"/> 

     
   	 <jar jarfile="${dist.dir}/sqlServer.jar">
      <fileset dir="${buildTDS.dir}"/>
      <manifest>
		<attribute name="Specification-Title" value="jTDS for MS SQL JDBC"/>
		<attribute name="Specification-Version" value="jTDS 1.0"/>
		<attribute name="Specification-Vendor" value="jTDS"/>
		<attribute name="Implementation-Title" value="sqlServer ${env.COMPIERE_VERSION}"/>
		<attribute name="Implementation-Version" value="${env.COMPIERE_VERSION} ${DSTAMP}-${TSTAMP}"/>
		<attribute name="Implementation-Vendor" value="${env.COMPIERE_VENDOR}"/>
		<attribute name="Implementation-URL" value="http://www.compiere.com"/>
		<attribute name="Permissions" value="all-permissions"/>
      </manifest>
    </jar>
     
     <!-- Create sqlServer file new jdbc driver	-->


    <!-- <unjar src="lib/mssql-jdbc.jar" dest="${buildTDS.dir}"/> 	-->

     <!--

     <jar jarfile="${dist.dir}/sqlServer.jar">
      <fileset dir="${buildTDS.dir}"/>
      <manifest>
		<attribute name="Specification-Title" value="microsoft sqlserver jdbc"/>
		<attribute name="Specification-Version" value="jdbc-9.4.1"/>
		<attribute name="Specification-Vendor" value="Microsoft"/>
		<attribute name="Implementation-Title" value="sqlServer ${env.COMPIERE_VERSION}"/>
		<attribute name="Implementation-Version" value="${env.COMPIERE_VERSION} ${DSTAMP}-${TSTAMP}"/>
		<attribute name="Implementation-Vendor" value="${env.COMPIERE_VENDOR}"/>
		<attribute name="Implementation-URL" value="http://www.solsticeplus.com"/>
		<attribute name="Permissions" value="all-permissions"/>
      </manifest>
    </jar>   
-->
		

    <!-- Clean up			-->

    
    

  </target>
	

  <!-- ============================================= -->
  <!-- Buld Server Jar                               -->
  <!-- ============================================= -->
  <target name="toolsServer" depends="toolsCompile" 
  	unless="jars.uptodate"
	description="Create CSTools.jar">

    <!-- Unjar libraries for CSTools *****			-->
    <!-- JSTL				-->
    <unjar src="lib/jstl.jar" dest="${buildServer.dir}" />
    <unjar src="lib/standard.jar" dest="${buildServer.dir}" />
    <!-- ECS, etc				-->
    <copy todir="${buildServer.dir}/org">
      <fileset dir="${build.dir}/org" />
    </copy> 
    <!-- Payment Processors		-->
    <unjar src="lib/Verisign.jar" dest="${buildServer.dir}" />
    <unjar src="lib/jpayment.jar" dest="${buildServer.dir}" />
    <!-- Log4J, jnlp			-->
  	<unjar src="lib/crystal/log4j-core.jar" dest="${buildServer.dir}" /> 
  	<unjar src="lib/crystal/log4j-api.jar" dest="${buildServer.dir}" /> 
    <unjar src="lib/jnlp.jar" dest="${buildServer.dir}"/>
    <!-- Barcode, ftp			-->
    <unjar src="lib/barbecue-1.0.6d.jar" dest="${buildServer.dir}"/>
    <unjar src="lib/commons-net-1.4.0.jar" dest="${buildServer.dir}"/>


    <unjar src="lib/axis-1.2.jar" dest="${buildServer.dir}" />


    <unjar src="lib/json-20231013.jar" dest="${buildServer.dir}" />
    <unjar src="lib/gson-2.9.0.jar" dest="${buildServer.dir}" />

    <!-- SFTP -->
    <unjar src="lib/jxl.jar" dest="${buildServer.dir}" />


    <unjar src="lib/pdfbox-app-2.0.4.jar" dest="${buildServer.dir}" />

    <!-- Clean up			-->
    <delete file="${buildServer.dir}/META-INF/MANIFEST.MF" failonerror="false"/>

    <!-- Create CSTools jar		-->
    <jar jarfile="${dist.dir}/CSTools.jar">
      <fileset dir="${buildServer.dir}" />
      <manifest>
		<attribute name="Specification-Title" value="Compiere Server Tools"/>
		<attribute name="Specification-Version" value="${env.COMPIERE_VERSION}"/>
		<attribute name="Specification-Vendor" value="(C) 2006 ComPiere, Inc."/>
		<attribute name="Implementation-Title" value="CSTools ${env.COMPIERE_VERSION}"/>
		<attribute name="Implementation-Version" value="${env.COMPIERE_VERSION} ${DSTAMP}-${TSTAMP}"/>
		<attribute name="Implementation-Vendor" value="${env.COMPIERE_VENDOR}"/>
		<attribute name="Implementation-URL" value="http://www.compiere.org"/>
		<attribute name="Permissions" value="all-permissions"/>
      </manifest>
    </jar>

  </target>

  <!-- ============================================= -->
  <!-- Buld Client Jar                               -->
  <!-- ============================================= -->
  <target name="toolsClient" depends="toolsCompile" 
  	unless="jars.uptodate"
	description="Create CCTools.jar">

    <!-- Unjar libraries for CCTools *****			-->
    <!-- Mail				-->
    <unjar src="lib/activation.jar" dest="${buildClient.dir}" />
    <unjar src="lib/mail.jar" dest="${buildClient.dir}" />
    <!-- Bean Shell			-->
    <unjar src="lib/bsh-1.3.0.jar" dest="${buildClient.dir}" />
    <!-- ECS, etc				-->
    <copy todir="${buildClient.dir}/org">
      <fileset dir="${build.dir}/org" />
    </copy> 
    <!-- Payment Processors		-->
    <unjar src="lib/Verisign.jar" dest="${buildClient.dir}" />
    <unjar src="lib/jpayment.jar" dest="${buildClient.dir}" />
    <!-- Log4J, jnlp			-->
   <!-- <unjar src="lib/log4j.jar" dest="${buildClient.dir}"/>  -->
    <unjar src="lib/jnlp.jar" dest="${buildClient.dir}"/>
    <!-- Barcode, ftp			-->
    <unjar src="lib/barbecue-1.0.6d.jar" dest="${buildClient.dir}"/>
    <unjar src="lib/commons-net-1.4.0.jar" dest="${buildClient.dir}"/>

    <unjar src="lib/jxl.jar" dest="${buildClient.dir}" />
   <!--<unjar src="lib/javax.servlet.jar" dest="${buildClient.dir}" />-->

    <!-- Crystal Jar -->

    <unjar src="lib/crystal/CrystalReportsRuntime.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/CrystalCommon2.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/DatabaseConnectors.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/logging.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/keycodeDecoder.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/commons-configuration-1.2.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/commons-lang-2.1.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/commons-collections-3.2.2.jar" dest="${buildClient.dir}" /> 

    <unjar src="lib/crystal/cvom.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/JDBInterface.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/pfjgraphics.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/QueryBuilder.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/commons-logging.jar" dest="${buildClient.dir}" /> 
  	<unjar src="lib/crystal/log4j-core.jar" dest="${buildClient.dir}" /> 
  	<unjar src="lib/crystal/log4j-api.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/xpp3.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/jai_imageio.jar" dest="${buildClient.dir}" /> 
    <unjar src="lib/crystal/com.azalea.ufl.barcode.1.0.jar" dest="${buildClient.dir}" /> 
  	<unjar src="lib/crystal/icu4j.jar" dest="${buildClient.dir}" /> 


    <unjar src="lib/axis-1.2.jar" dest="${buildClient.dir}" />

    <unjar src="lib/gson-2.9.0.jar" dest="${buildClient.dir}" />


    <!-- SFTP --> 
    <unjar src="lib/pdfbox-app-2.0.4.jar" dest="${buildClient.dir}" />

    <!-- OAuth 2.0 --> 

	<unjar src="lib/okio-3.9.0.jar" dest="${buildClient.dir}" />
	<unjar src="lib/okio-jvm-3.7.0.jar" dest="${buildClient.dir}" />
	<unjar src="lib/kotlin-stdlib-1.9.21.jar" dest="${buildClient.dir}" />
	<unjar src="lib/annotations-13.0.jar" dest="${buildClient.dir}" />
	<unjar src="lib/okhttp-jvm-5.0.0-alpha.12.jar" dest="${buildClient.dir}" />

    <!-- Clean up			-->
    <delete>
      <fileset dir="${buildClient.dir}" includes="build.xml"/>
      <fileset dir="${buildClient.dir}/META-INF" casesensitive="no" includes="*.mf,*.sf,*.rsa,*.dsa"/>
    </delete>

    <!-- Create CCTools.jar file 	-->
    <jar jarfile="${dist.dir}/CCTools.jar">
      <fileset dir="${buildClient.dir}"/>
      <manifest>
		<attribute name="Specification-Title" value="Compiere Client Tools"/>
		<attribute name="Specification-Version" value="${env.COMPIERE_VERSION}"/>
		<attribute name="Specification-Vendor" value="(C) 2006 ComPiere, Inc."/>
		<attribute name="Implementation-Title" value="CCTools ${env.COMPIERE_VERSION}"/>
		<attribute name="Implementation-Version" value="${env.COMPIERE_VERSION} ${DSTAMP}-${TSTAMP}"/>
		<attribute name="Implementation-Vendor" value="${env.COMPIERE_VENDOR}"/>
		<attribute name="Implementation-URL" value="http://www.compiere.org"/>
		<attribute name="Permissions" value="all-permissions"/>
      </manifest>
    </jar>

  </target>
	
	
  <!-- ============================================= -->
  <!-- Buld Jars                                     -->
  <!-- ============================================= -->
  <target name="toolsDistribution" 
  	depends="toolsServer, toolsClient, toolsAppsServer, toolsDatabase" 
  	unless="jars.uptodate"
	description="Create jars">

  </target>


  <!-- ============================================= -->
  <!-- Clean up                                      -->
  <!-- ============================================= -->
  <target name="clean">
    <!-- Delete the ${build.dir} directory trees -->
    <delete dir="${build.dir}"/>
    <delete file="${dist.dir}/CCTools.jar" failonerror="false"/>
    <delete file="${dist.dir}/CSTools.jar" failonerror="false"/>
    <delete file="${dist.dir}/ibmWAS.jar" failonerror="false"/>
    <delete file="${dist.dir}/oracle.jar" failonerror="false"/>
    <delete file="${dist.dir}/db2.jar" failonerror="false"/>
    <delete file="${dist.dir}/sqljdbc.jar" failonerror="false"/>
    <delete file="${dist.dir}/sqlServer.jar" failonerror="false"/>
    <delete file="${dist.dir}/postgreSQL.jar" failonerror="false"/>
  </target>

</project>
