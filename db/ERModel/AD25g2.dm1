7,24,2,1,"SELECT psc.AD_Client_ID, psc.AD_Org_ID, l.AD_Language, psc.C_PaySelection_ID, psc.C_PaySelectionCheck_ID, oi.C_Location_ID Org_Location_ID, oi.TaxID, 0 C_DocType_ID, bp.C_BPartner_ID, bp.Value BPValue, bpg.Name BPGreeting, bp.Name, bp.Name2, C_BPartner_RemitLocation(bp.C_BPartner_ID) C_Location_ID, bp.ReferenceNo, bp.POReference, ps.PayDate, psc.PayAmt, psc.PayAmt AmtInWords, psc.Qty, psc.PaymentRule, psc.DocumentNo, l.AD_Language_ID, bp.SOCreditStatus, bp.ShelfLifeMinPct, bp.SalesRep_ID, oi.Supervisor_ID, oi.Parent_Org_ID, ps.IsActive, ps.IsApproved, ps.Processed",48596,0
