162,19,1,0,"CREATE VIEW AD_Field_vt AS
SELECT trl.AD_Language, t.AD_Window_ID, f.AD_Tab_ID, f.AD_Field_ID, tbl.AD_Table_ID, f.AD_Column_ID, trl.Name, trl.Description, trl.Help, f.DisplayLogic, f.DisplayLength, f.SeqNo, f.SortNo, c.ColumnName, c.FieldLength, c.VFormat, c.DefaultValue, c.AD_Reference_Value_ID, c.Callout, c.AD_Reference_ID, c.AD_Val_Rule_ID, c.AD_Process_ID, c.ReadOnlyLogic, tbl.TableName, c.ValueMin, c.ValueMax, fgt.Name FieldGroup, f.ObscureType
FROM AD_Field f 
	INNER JOIN AD_Field_Trl trl ON (f.AD_Field_ID = trl.AD_Field_ID)
	LEFT OUTER JOIN AD_FieldGroup_Trl fgt ON 
		(f.AD_FieldGroup_ID = fgt.AD_FieldGroup_ID AND trl.AD_Language=fgt.AD_Language)
	LEFT OUTER JOIN AD_Column c ON (f.AD_Column_ID = c.AD_Column_ID)
	  INNER JOIN AD_Table tbl ON (c.AD_Table_ID = tbl.AD_Table_ID)
	  INNER JOIN AD_Reference r ON (c.AD_Reference_ID = r.AD_Reference_ID)
	INNER JOIN AD_Tab t ON (f.AD_Tab_ID = t.AD_Tab_ID)
WHERE trl.AD_Field_ID = f.AD_Field_ID AND f.AD_Column_ID = c.AD_Column_ID AND c.AD_Table_ID = tbl.AD_Table_ID AND c.AD_Reference_ID = r.AD_Reference_ID AND c.AD_Reference_Value_ID = r.AD_Reference_ID AND c.AD_Reference_ID = r.AD_Reference_ID AND c.AD_Reference_Value_ID = r.AD_Reference_ID AND t.AD_Table_ID = tbl.AD_Table_ID AND t.AD_Column_ID = c.AD_Column_ID AND t.AD_ColumnSortYesNo_ID = c.AD_Column_ID AND t.AD_ColumnSortOrder_ID = c.AD_Column_ID AND f.AD_Tab_ID = t.AD_Tab_ID
",48751,0
163,19,1,1,"CREATE VIEW AD_Field_vt AS
SELECT trl.AD_Language, t.AD_Window_ID, f.AD_Tab_ID, f.AD_Field_ID, tbl.AD_Table_ID, f.AD_Column_ID, trl.Name, trl.Description, trl.Help, f.DisplayLogic, f.DisplayLength, f.SeqNo, f.SortNo, c.ColumnName, c.FieldLength, c.VFormat, c.DefaultValue, c.AD_Reference_Value_ID, c.Callout, c.AD_Reference_ID, c.AD_Val_Rule_ID, c.AD_Process_ID, c.ReadOnlyLogic, tbl.TableName, c.ValueMin, c.ValueMax, fgt.Name FieldGroup, f.ObscureType, f.IsMandatory
FROM AD_Field f 
	INNER JOIN AD_Field_Trl trl ON (f.AD_Field_ID = trl.AD_Field_ID)
	LEFT OUTER JOIN AD_FieldGroup_Trl fgt ON 
		(f.AD_FieldGroup_ID = fgt.AD_FieldGroup_ID AND trl.AD_Language=fgt.AD_Language)
	LEFT OUTER JOIN AD_Column c ON (f.AD_Column_ID = c.AD_Column_ID)
	  INNER JOIN AD_Table tbl ON (c.AD_Table_ID = tbl.AD_Table_ID)
	  INNER JOIN AD_Reference r ON (c.AD_Reference_ID = r.AD_Reference_ID)
	INNER JOIN AD_Tab t ON (f.AD_Tab_ID = t.AD_Tab_ID)
WHERE trl.AD_Field_ID = f.AD_Field_ID AND f.AD_Column_ID = c.AD_Column_ID AND c.AD_Table_ID = tbl.AD_Table_ID AND c.AD_Reference_ID = r.AD_Reference_ID AND c.AD_Reference_Value_ID = r.AD_Reference_ID AND c.AD_Reference_ID = r.AD_Reference_ID AND c.AD_Reference_Value_ID = r.AD_Reference_ID AND t.AD_Table_ID = tbl.AD_Table_ID AND t.AD_Column_ID = c.AD_Column_ID AND t.AD_ColumnSortYesNo_ID = c.AD_Column_ID AND t.AD_ColumnSortOrder_ID = c.AD_Column_ID AND f.AD_Tab_ID = t.AD_Tab_ID
