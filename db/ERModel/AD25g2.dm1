    null, null,
    t.Name,
    null, null, null,
    null, null,
    it.TaxBaseAmt, it.TaxAmt
FROM C_InvoiceTax it
    INNER JOIN C_Tax t ON (it.C_Tax_ID=t.C_Tax_ID), AD_Language l
WHERE l.IsBaseLanguage='N' AND l.IsSystemLanguage='Y'
