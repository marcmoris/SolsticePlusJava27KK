320,26,1,1,"CREATE VIEW C_Invoice_Header_vt AS
SELECT i.AD_Client_ID, i.AD_Org_ID, i.IsActive, i.Created, i.CreatedBy, i.Updated, i.UpdatedBy, dt.AD_Language, i.C_Invoice_ID, i.IsSOTrx, i.DocumentNo, i.DocStatus, i.C_DocType_ID, i.C_BPartner_ID, bp.Value BPValue, oi.C_Location_ID Org_Location_ID, oi.TaxID, dt.PrintName DocumentType, dt.DocumentNote DocumentTypeNote, i.C_Order_ID, COALESCE(ubp.Name, u.Name) SalesRep_Name, i.DateInvoiced, bpg.Name BPGreeting, bp.Name, bp.Name2, bpcg.Name BPContactGreeting, NULLIF (bpc.Name, bp.Name) ContactName, bpl.C_Location_ID, bp.ReferenceNo, i.Description, i.POReference, i.DateOrdered, i.C_Currency_ID, pt.Name PaymentTerm, pt.DocumentNote PaymentTermNote, i.C_Charge_ID, i.ChargeAmt, i.TotalLines, i.GrandTotal, i.M_PriceList_ID, i.IsTaxIncluded, i.C_Campaign_ID, i.C_Project_ID, i.C_Activity_ID, i.IsPaid, bp.SendEMail, i.CopyFrom, u.Comments, u.Phone, u.Phone2, u.Fax, u.Birthday, u.LastContact, u.LastResult
FROM C_Invoice i, C_DocType_Trl dt, C_PaymentTerm_Trl pt, C_BPartner bp, C_Greeting_Trl bpg, C_BPartner_Location bpl, C_Greeting_Trl bpcg, AD_OrgInfo oi, AD_User u, C_BPartner ubp
WHERE i.C_BPartner_ID = bp.C_BPartner_ID AND bpl.C_BPartner_ID = bp.C_BPartner_ID AND i.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND u.C_BPartner_ID = bp.C_BPartner_ID AND u.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND i.SalesRep_ID = u.AD_User_ID AND i.AD_User_ID = u.AD_User_ID AND i.SalesRep_ID = u.AD_User_ID AND i.AD_User_ID = u.AD_User_ID AND i.C_BPartner_ID = ubp.C_BPartner_ID AND bpl.C_BPartner_ID = ubp.C_BPartner_ID AND u.C_BPartner_ID = ubp.C_BPartner_ID
",48909,0
321,14,1,0,"CREATE VIEW C_Invoice_LineTax_v AS
SELECT il.AD_Client_ID, il.AD_Org_ID, il.IsActive, il.Created, il.CreatedBy, il.Updated, il.UpdatedBy, 'en_US' AD_Language, il.C_Invoice_ID, il.C_InvoiceLine_ID, il.C_Tax_ID, il.Line, il.QtyInvoiced, uom.UOMSymbol, COALESCE(p.Name, il.Description) Name, CASE WHEN p.Name IS NOT NULL THEN il.Description END Description, p.DocumentNote, ra.Description ResourceDescription, CASE WHEN i.IsDiscountPrinted='Y' THEN il.PriceList END PriceList, CASE WHEN i.IsDiscountPrinted='Y' AND il.PriceList>il.PriceActual THEN (il.PriceList-il.PriceActual)/il.PriceList*100 END Discount, il.PriceActual, il.LineNetAmt, C_Invoice.SendEMail, il.TaxAmt, p.DownloadURL, C_Invoice.CopyFrom, i.IsSelfService
FROM    C_InvoiceLine il
    INNER JOIN C_UOM uom ON (il.C_UOM_ID=uom.C_UOM_ID)
    INNER JOIN C_Invoice i ON (il.C_Invoice_ID=i.C_Invoice_ID)
    LEFT OUTER JOIN M_Product p ON (il.M_PRODUCT_ID=p.M_PRODUCT_ID)
    LEFT OUTER JOIN S_ResourceAssignment ra ON (il.S_ResourceAssignment_ID=ra.S_ResourceAssignment_ID)
UNION
SELECT il.AD_Client_ID, il.AD_Org_ID, il.IsActive, il.Created, il.CreatedBy, il.Updated, il.UpdatedBy,
	'en_US', il.C_Invoice_ID, il.C_InvoiceLine_ID, il.C_Tax_ID,
    il.Line,
    null, null,
    il.Description,
    null, null, null,
    null, null,
    null, null
FROM C_InvoiceLine il
WHERE il.C_UOM_ID IS NULL
UNION
SELECT AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy,
	'en_US', C_Invoice_ID, null, null,
    9998,
    null, null,
    null,
    null, null, null,
    null, null,
    null, null
FROM C_Invoice
UNION
SELECT it.AD_Client_ID, it.AD_Org_ID, it.IsActive, it.Created, it.CreatedBy, it.Updated, it.UpdatedBy,
    'en_US', it.C_Invoice_ID, null, it.C_Tax_ID,
    9999,
    null, null,
    t.Name,
    null, null, null,
    null, null,
    it.TaxBaseAmt, it.TaxAmt
FROM C_InvoiceTax it
    INNER JOIN C_Tax t ON (it.C_Tax_ID=t.C_Tax_ID)
WHERE p.C_UOM_ID = uom.C_UOM_ID AND il.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND il.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND il.M_Product_ID = p.M_Product_ID AND il.C_Invoice_ID = C_Invoice.C_Invoice_ID AND il.M_Product_ID = p.M_Product_ID AND il.C_UOM_ID = uom.C_UOM_ID AND il.C_Tax_ID = t.C_Tax_ID AND il.S_ResourceAssignment_ID = ra.S_ResourceAssignment_ID AND p.C_UOM_ID = uom.C_UOM_ID AND il.M_Product_ID = p.M_Product_ID AND il.C_Invoice_ID = C_Invoice.C_Invoice_ID AND it.C_Invoice_ID = C_Invoice.C_Invoice_ID AND il.C_Invoice_ID = i.C_Invoice_ID AND it.C_Invoice_ID = i.C_Invoice_ID AND il.C_Invoice_ID = C_Invoice.C_Invoice_ID AND it.C_Invoice_ID = C_Invoice.C_Invoice_ID AND il.C_Invoice_ID = i.C_Invoice_ID AND it.C_Invoice_ID = i.C_Invoice_ID AND il.C_Invoice_ID = i.C_Invoice_ID AND it.C_Invoice_ID = i.C_Invoice_ID AND il.C_Invoice_ID = C_Invoice.C_Invoice_ID AND it.C_Invoice_ID = C_Invoice.C_Invoice_ID AND il.C_Invoice_ID = i.C_Invoice_ID AND it.C_Invoice_ID = i.C_Invoice_ID AND il.C_Invoice_ID = C_Invoice.C_Invoice_ID AND it.C_Invoice_ID = C_Invoice.C_Invoice_ID AND p.C_UOM_ID = uom.C_UOM_ID AND il.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND il.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND il.M_Product_ID = p.M_Product_ID AND il.C_Invoice_ID = i.C_Invoice_ID AND it.C_Invoice_ID = i.C_Invoice_ID AND il.C_Invoice_ID = C_Invoice.C_Invoice_ID AND it.C_Invoice_ID = C_Invoice.C_Invoice_ID AND il.C_Invoice_ID = i.C_Invoice_ID AND it.C_Invoice_ID = i.C_Invoice_ID AND il.C_Invoice_ID = C_Invoice.C_Invoice_ID AND it.C_Invoice_ID = C_Invoice.C_Invoice_ID AND il.C_Invoice_ID = i.C_Invoice_ID AND it.C_Invoice_ID = i.C_Invoice_ID AND il.C_Invoice_ID = C_Invoice.C_Invoice_ID AND it.C_Invoice_ID = C_Invoice.C_Invoice_ID
",48910,0
322,5,1,0,"CREATE VIEW AD_Tab_v AS
SELECT t.AD_Tab_ID, t.AD_Window_ID, t.AD_Table_ID, t.Name, t.Description, t.Help, t.SeqNo, tbl.TableName, tbl.AccessLevel, t.AD_Image_ID, t.TabLevel, t.WhereClause, t.OrderByClause, t.CommitWarning, t.AD_Column_ID, t.AD_Process_ID, t.AD_ColumnSortOrder_ID, t.AD_ColumnSortYesNo_ID
FROM AD_Tab t 
    INNER JOIN AD_Table tbl ON (t.AD_Table_ID = tbl.AD_Table_ID)
WHERE t.AD_Table_ID = tbl.AD_Table_ID
",48911,0
323,7,1,0,"CREATE VIEW AD_Field_v AS
SELECT t.AD_Window_ID, f.AD_Tab_ID, f.AD_Field_ID, tbl.AD_Table_ID, f.AD_Column_ID, f.Name, f.Description, f.Help, f.DisplayLogic, f.DisplayLength, f.SeqNo, f.SortNo, c.ColumnName, c.FieldLength, c.VFormat, c.DefaultValue, c.AD_Reference_Value_ID, c.Callout, c.AD_Reference_ID, c.AD_Val_Rule_ID, c.AD_Process_ID, c.ReadOnlyLogic, tbl.TableName, c.ValueMin, c.ValueMax, fg.Name FieldGroup, f.ObscureType, fg.EntityType, f.IsMandatory, c.TableUID
FROM (AD_Field f LEFT OUTER JOIN AD_Column c ON (f.AD_Column_ID = c.AD_Column_ID)) 
	LEFT OUTER JOIN AD_FieldGroup fg ON (f.AD_FieldGroup_ID = fg.AD_FieldGroup_ID), 
	AD_Table tbl, AD_Tab t, AD_Reference r
WHERE f.AD_Column_ID = c.AD_Column_ID AND f.AD_FieldGroup_ID = fg.AD_FieldGroup_ID AND c.AD_Table_ID = tbl.AD_Table_ID AND t.AD_Table_ID = tbl.AD_Table_ID AND t.AD_Column_ID = c.AD_Column_ID AND t.AD_ColumnSortYesNo_ID = c.AD_Column_ID AND t.AD_ColumnSortOrder_ID = c.AD_Column_ID AND f.AD_Tab_ID = t.AD_Tab_ID AND c.AD_Reference_ID = r.AD_Reference_ID AND c.AD_Reference_Value_ID = r.AD_Reference_ID AND c.AD_Reference_ID = r.AD_Reference_ID AND c.AD_Reference_Value_ID = r.AD_Reference_ID
",48912,0
324,21,1,0,"CREATE VIEW C_PaySelection_Check_v AS
SELECT psc.AD_Client_ID, psc.AD_Org_ID, 'en_US' AD_Language, psc.C_PaySelection_ID, psc.C_PaySelectionCheck_ID, oi.C_Location_ID Org_Location_ID, oi.TaxID, 0 C_DocType_ID, bp.C_BPartner_ID, bp.Value BPValue, bpg.Name BPGreeting, bp.Name, bp.Name2, C_BPartner_RemitLocation(bp.C_BPartner_ID) C_Location_ID, bp.ReferenceNo, bp.POReference, ps.PayDate, psc.PayAmt, psc.PayAmt AmtInWords, psc.Qty, psc.PaymentRule, psc.DocumentNo, bp.SOCreditStatus, bp.ShelfLifeMinPct, bp.SalesRep_ID, oi.Supervisor_ID, oi.Parent_Org_ID
FROM C_PaySelectionCheck psc
    INNER JOIN C_PaySelection ps ON (psc.C_PaySelection_ID=ps.C_PaySelection_ID)
    INNER JOIN C_BPartner bp ON (psc.C_BPartner_ID=bp.C_BPartner_ID)
    LEFT OUTER JOIN C_Greeting bpg on (bp.C_Greeting_ID=bpg.C_Greeting_ID)
    INNER JOIN AD_OrgInfo oi ON (psc.AD_Org_ID=oi.AD_Org_ID)
WHERE bp.C_Greeting_ID = bpg.C_Greeting_ID AND psc.C_BPartner_ID = bp.C_BPartner_ID AND bp.C_Greeting_ID = bpg.C_Greeting_ID AND psc.C_BPartner_ID = bp.C_BPartner_ID AND bp.C_Greeting_ID = bpg.C_Greeting_ID AND psc.C_BPartner_ID = bp.C_BPartner_ID AND bp.C_Greeting_ID = bpg.C_Greeting_ID AND psc.C_BPartner_ID = bp.C_BPartner_ID AND psc.C_PaySelection_ID = ps.C_PaySelection_ID AND bp.C_Greeting_ID = bpg.C_Greeting_ID AND psc.C_BPartner_ID = bp.C_BPartner_ID
",48913,0
325,24,1,1,"CREATE VIEW C_PaySelection_Check_vt AS
