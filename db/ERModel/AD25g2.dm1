229,12,1,0,"CREATE VIEW C_Invoice_LineTax_v AS
SELECT il.AD_Client_ID, il.AD_Org_ID, il.IsActive, il.Created, il.CreatedBy, il.Updated, il.UpdatedBy, 'en_US' AD_Language, il.C_Invoice_ID, il.C_InvoiceLine_ID, il.C_Tax_ID, il.Line, il.QtyInvoiced, uom.UOMSymbol, COALESCE(p.Name, il.Description) Name, CASE WHEN p.Name IS NOT NULL THEN il.Description END Description, p.DocumentNote, ra.Description ResourceDescription, CASE WHEN i.IsDiscountPrinted='Y' THEN il.PriceList END PriceList, CASE WHEN i.IsDiscountPrinted='Y' AND il.PriceList>il.PriceActual THEN (il.PriceList-il.PriceActual)/il.PriceList*100 END Discount, il.PriceActual, il.LineNetAmt, C_Invoice.SendEMail, il.TaxAmt, p.DownloadURL, C_Invoice.CopyFrom, i.IsSelfService
FROM    C_InvoiceLine il
    INNER JOIN C_UOM uom ON (il.C_UOM_ID=uom.C_UOM_ID)
    INNER JOIN C_Invoice i ON (il.C_Invoice_ID=i.C_Invoice_ID)
    LEFT OUTER JOIN M_Product p ON (il.M_PRODUCT_ID=p.M_PRODUCT_ID)
    LEFT OUTER JOIN S_ResourceAssignment ra ON (il.S_ResourceAssignment_ID=ra.S_ResourceAssignment_ID)
UNION
