290,31,1,0,"CREATE VIEW M_InOut_Line_v AS
SELECT iol.AD_Client_ID, iol.AD_Org_ID, iol.Created, iol.CreatedBy, iol.Updated, iol.UpdatedBy, 'en_US' AD_Language, iol.M_InOut_ID, iol.M_InOutLine_ID, iol.Line, iol.MovementQty, uom.UOMSymbol, COALESCE(p.Name, iol.Description) Name, CASE WHEN p.Name IS NOT NULL THEN iol.Description END Description, p.DocumentNote, iol.M_Locator_ID, p.DownloadURL, p.GuaranteeDaysMin
FROM    M_InOutLine iol
    INNER JOIN C_UOM uom ON (iol.C_UOM_ID=uom.C_UOM_ID)
    LEFT OUTER JOIN M_Product p ON (iol.M_PRODUCT_ID=p.M_PRODUCT_ID)
WHERE p.C_UOM_ID = uom.C_UOM_ID AND iol.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND iol.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND iol.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND iol.C_UOM_ID = uom.C_UOM_ID AND p.C_UOM_ID = uom.C_UOM_ID AND iol.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND iol.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND iol.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND iol.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND iol.M_Product_ID = p.M_Product_ID
