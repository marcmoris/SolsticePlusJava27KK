56,26,1,0,"CREATE VIEW C_Invoice_Header_vt AS
SELECT i.AD_Client_ID, i.AD_Org_ID, i.IsActive, i.Created, i.CreatedBy, i.Updated, i.UpdatedBy, dt.AD_Language, i.C_Invoice_ID, i.IsSOTrx, i.DocumentNo, i.DocStatus, i.C_DocType_ID, i.C_BPartner_ID, bp.Value BPValue, oi.C_Location_ID Org_Location_ID, oi.TaxID, dt.PrintName DocumentType, dt.DocumentNote DocumentTypeNote, i.C_Order_ID, COALESCE(ubp.Name, u.Name) SalesRep_Name, i.DateInvoiced, bpg.Name BPGreeting, bp.Name, bp.Name2, bpcg.Name BPContactGreeting, bpc.Title, NULLIF (bpc.Name, bp.Name) ContactName, bpl.C_Location_ID, bp.ReferenceNo, i.Description, i.POReference, i.DateOrdered, i.C_Currency_ID, pt.Name PaymentTerm, pt.DocumentNote PaymentTermNote, i.C_Charge_ID, i.ChargeAmt, i.TotalLines, i.GrandTotal, i.M_PriceList_ID, i.IsTaxIncluded, i.C_Campaign_ID, i.C_Project_ID, i.C_Activity_ID, i.IsPaid, bp.SendEMail, i.CopyFrom, u.Comments, u.Phone, u.Phone2, u.Fax, u.Birthday, u.LastContact, u.LastResult
FROM C_Invoice i, C_DocType_Trl dt, C_PaymentTerm_Trl pt, C_BPartner bp, C_Greeting_Trl bpg, C_BPartner_Location bpl, C_BPartner_Contact bpc, C_Greeting_Trl bpcg, AD_OrgInfo oi, AD_User u, C_BPartner ubp
