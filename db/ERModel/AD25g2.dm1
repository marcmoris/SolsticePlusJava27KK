FROM C_Order o, C_DocType dt, C_PaymentTerm pt, C_BPartner bp, C_Greeting bpg, C_BPartner_Location bpl, C_BPartner_Contact bpc, C_Greeting bpcg, AD_OrgInfo oi, AD_User u, C_BPartner ubp
