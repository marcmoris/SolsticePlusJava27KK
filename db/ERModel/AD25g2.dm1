84,13,1,0,"CREATE VIEW C_Order_LineTax_v AS
SELECT ol.AD_Client_ID, ol.AD_Org_ID, ol.IsActive, ol.Created, ol.CreatedBy, ol.Updated, ol.UpdatedBy, 'en_US' AD_Language, ol.C_Order_ID, ol.C_OrderLine_ID, ol.C_Tax_ID, ol.Line, ol.QtyOrdered, uom.UOMSymbol, COALESCE(p.Name, ol.Description) Name, CASE WHEN p.Name IS NOT NULL THEN ol.Description END Description, p.DocumentNote, ra.Description ResourceDescription, CASE WHEN i.IsDiscountPrinted='Y' THEN ol.PriceList END PriceList, CASE WHEN i.IsDiscountPrinted='Y' AND ol.PriceList>ol.PriceActual THEN (ol.PriceList-ol.PriceActual)/ol.PriceList*100 END Discount, ol.PriceActual, ol.LineNetAmt, C_Order.SendEMail, p.DownloadURL, C_Order.CopyFrom
FROM    C_OrderLine ol
    INNER JOIN C_UOM uom ON (ol.C_UOM_ID=uom.C_UOM_ID)
    INNER JOIN C_Order i ON (ol.C_Order_ID=i.C_Order_ID)
    LEFT OUTER JOIN M_Product p ON (ol.M_PRODUCT_ID=p.M_PRODUCT_ID)
    LEFT OUTER JOIN S_ResourceAssignment ra ON (ol.S_ResourceAssignment_ID=ra.S_ResourceAssignment_ID)
UNION
SELECT AD_Client_ID, AD_Org_ID, IsActive, Created, CreatedBy, Updated, UpdatedBy,
	'en_US', C_Order_ID, null, null,
    null,
    null, null,
    null,
    null, null, null,
    null, null,
    null, null
FROM C_Order
UNION
SELECT ot.AD_Client_ID, ot.AD_Org_ID, ot.IsActive, ot.Created, ot.CreatedBy, ot.Updated, ot.UpdatedBy,
    'en_US', ot.C_Order_ID, null, ot.C_Tax_ID,
    null,
    null, null,
    t.Name,
    null, null, null,
    null,null,
    ot.TaxBaseAmt, ot.TaxAmt
FROM C_OrderTax ot
    INNER JOIN C_Tax t ON (ot.C_Tax_ID=t.C_Tax_ID)
WHERE p.C_UOM_ID = uom.C_UOM_ID AND ol.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND ol.M_Product_ID = p.M_Product_ID AND p.C_UOM_ID = uom.C_UOM_ID AND ol.M_Product_ID = p.M_Product_ID AND ol.C_Order_ID = C_Order.C_Order_ID AND ol.M_Product_ID = p.M_Product_ID AND ol.C_UOM_ID = uom.C_UOM_ID AND ol.C_Tax_ID = t.C_Tax_ID AND ol.S_ResourceAssignment_ID = ra.S_ResourceAssignment_ID AND p.C_UOM_ID = uom.C_UOM_ID AND ol.M_Product_ID = p.M_Product_ID
