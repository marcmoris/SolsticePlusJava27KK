185,14,2,1,"SELECT il.AD_Client_ID, il.AD_Org_ID, il.IsActive, il.Created, il.CreatedBy, il.Updated, il.UpdatedBy, 'en_US' AD_Language, il.C_Invoice_ID, il.C_InvoiceLine_ID, il.C_Tax_ID, il.Line, il.QtyInvoiced, uom.UOMSymbol, COALESCE(p.Name, il.Description) Name, CASE WHEN p.Name IS NOT NULL THEN il.Description END Description, p.DocumentNote, ra.Description ResourceDescription, CASE WHEN i.IsDiscountPrinted='Y' THEN il.PriceList END PriceList, CASE WHEN i.IsDiscountPrinted='Y' AND il.PriceList>il.PriceActual THEN (il.PriceList-il.PriceActual)/il.PriceList*100 END Discount, il.PriceActual, il.LineNetAmt, C_Invoice.SendEMail, il.TaxAmt, p.DownloadURL, C_Invoice.CopyFrom, i.IsSelfService, t.SOPOType",48774,0
186,14,1,1,"CREATE VIEW C_Invoice_LineTax_v AS
