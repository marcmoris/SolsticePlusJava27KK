124,7,1,1,"CREATE VIEW AD_Field_v AS
SELECT t.AD_Window_ID, f.AD_Tab_ID, f.AD_Field_ID, tbl.AD_Table_ID, f.AD_Column_ID, f.Name, f.Description, f.Help, f.DisplayLogic, f.DisplayLength, f.SeqNo, f.SortNo, c.ColumnName, c.FieldLength, c.VFormat, c.DefaultValue, c.AD_Reference_Value_ID, c.Callout, c.AD_Reference_ID, c.AD_Val_Rule_ID, c.AD_Process_ID, c.ReadOnlyLogic, tbl.TableName, c.ValueMin, c.ValueMax, fg.Name FieldGroup, f.ObscureType, fg.EntityType, f.IsMandatory, c.TableUID, c.ConstraintType
