339,27,2,1,"SELECT o.AD_Client_ID, o.AD_Org_ID, o.IsActive, o.Created, o.CreatedBy, o.Updated, o.UpdatedBy, dt.AD_Language, o.C_Order_ID, o.IsSOTrx, o.DocumentNo, o.DocStatus, o.C_DocType_ID, o.C_BPartner_ID, bp.Value BPValue, oi.C_Location_ID Org_Location_ID, oi.TaxID, dt.PrintName DocumentType, dt.DocumentNote DocumentTypeNote, COALESCE(ubp.Name, u.Name) SalesRep_Name, o.DateOrdered, o.DatePromised, bpg.Name BPGreeting, bp.Name, bp.Name2, bpcg.Name BPContactGreeting, NULLIF (bpc.Name, bp.Name) ContactName, bpl.C_Location_ID, bp.ReferenceNo, o.Description, o.POReference, o.C_Currency_ID, pt.Name PaymentTerm, pt.DocumentNote PaymentTermNote, o.C_Charge_ID, o.ChargeAmt, o.TotalLines, o.GrandTotal, o.M_PriceList_ID, o.IsTaxIncluded, o.C_Campaign_ID, o.C_Project_ID, o.C_Activity_ID, o.M_Shipper_ID, o.DeliveryRule, o.DeliveryViaRule, o.PriorityRule, o.InvoiceRule, bp.SendEMail, o.CopyFrom, u.Comments, u.Phone, u.Phone2, u.Fax, u.Birthday, u.LastContact, u.LastResult",48928,0
340,27,1,1,"CREATE VIEW C_Order_Header_vt AS
SELECT o.AD_Client_ID, o.AD_Org_ID, o.IsActive, o.Created, o.CreatedBy, o.Updated, o.UpdatedBy, dt.AD_Language, o.C_Order_ID, o.IsSOTrx, o.DocumentNo, o.DocStatus, o.C_DocType_ID, o.C_BPartner_ID, bp.Value BPValue, oi.C_Location_ID Org_Location_ID, oi.TaxID, dt.PrintName DocumentType, dt.DocumentNote DocumentTypeNote, COALESCE(ubp.Name, u.Name) SalesRep_Name, o.DateOrdered, o.DatePromised, bpg.Name BPGreeting, bp.Name, bp.Name2, bpcg.Name BPContactGreeting, NULLIF (bpc.Name, bp.Name) ContactName, bpl.C_Location_ID, bp.ReferenceNo, o.Description, o.POReference, o.C_Currency_ID, pt.Name PaymentTerm, pt.DocumentNote PaymentTermNote, o.C_Charge_ID, o.ChargeAmt, o.TotalLines, o.GrandTotal, o.M_PriceList_ID, o.IsTaxIncluded, o.C_Campaign_ID, o.C_Project_ID, o.C_Activity_ID, o.M_Shipper_ID, o.DeliveryRule, o.DeliveryViaRule, o.PriorityRule, o.InvoiceRule, bp.SendEMail, o.CopyFrom, u.Comments, u.Phone, u.Phone2, u.Fax, u.Birthday, u.LastContact, u.LastResult
FROM C_Order o, C_DocType_Trl dt, C_PaymentTerm_Trl pt, C_BPartner bp, C_Greeting_Trl bpg, C_BPartner_Location bpl, C_Greeting_Trl bpcg, AD_OrgInfo oi, AD_User u, C_BPartner ubp
WHERE o.C_BPartner_ID = bp.C_BPartner_ID AND bpl.C_BPartner_ID = bp.C_BPartner_ID AND o.BillTo_ID = bpl.C_BPartner_Location_ID AND o.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND o.BillTo_ID = bpl.C_BPartner_Location_ID AND o.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND u.C_BPartner_ID = bp.C_BPartner_ID AND u.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND o.SalesRep_ID = u.AD_User_ID AND o.AD_User_ID = u.AD_User_ID AND o.SalesRep_ID = u.AD_User_ID AND o.AD_User_ID = u.AD_User_ID AND o.C_BPartner_ID = ubp.C_BPartner_ID AND bpl.C_BPartner_ID = ubp.C_BPartner_ID AND u.C_BPartner_ID = ubp.C_BPartner_ID
",48929,0
341,44,4,1,"WHERE iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID AND pt.M_Product_ID = p.M_Product_ID AND iol.M_Product_ID = p.M_Product_ID
",48930,0
342,44,3,1,"FROM    M_InOutLine iol
    INNER JOIN C_UOM_Trl uom ON (iol.C_UOM_ID=uom.C_UOM_ID)
    LEFT OUTER JOIN M_Product p ON (iol.M_PRODUCT_ID=p.M_PRODUCT_ID)
    LEFT OUTER JOIN M_Product_Trl pt ON (iol.M_PRODUCT_ID=pt.M_PRODUCT_ID AND uom.AD_Language=pt.AD_Language)
",48931,0
343,45,1,1,"CREATE VIEW M_InOut_Header_vt AS
SELECT io.AD_Client_ID, io.AD_Org_ID, io.IsActive, io.Created, io.CreatedBy, io.Updated, io.UpdatedBy, dt.AD_Language, io.M_InOut_ID, io.IsSOTrx, io.DocumentNo, io.DocStatus, io.C_DocType_ID, io.C_BPartner_ID, bp.Value BPValue, oi.C_Location_ID Org_Location_ID, oi.TaxID, io.M_Warehouse_ID, wh.C_Location_ID Warehouse_Location_ID, dt.PrintName DocumentType, dt.DocumentNote DocumentTypeNote, io.C_Order_ID, io.MovementDate, io.MovementType, bpg.Name BPGreeting, bp.Name, bp.Name2, bpcg.Name BPContactGreeting, NULLIF (bpc.Name, bp.Name) ContactName, bpl.C_Location_ID, bp.ReferenceNo, io.Description, io.POReference, io.DateOrdered, io.M_Shipper_ID, io.DeliveryRule, io.DeliveryViaRule, io.PriorityRule, bp.SendEMail
FROM M_InOut io, C_DocType_Trl dt, C_BPartner bp, C_Greeting_Trl bpg, C_BPartner_Location bpl, C_Greeting_Trl bpcg, AD_OrgInfo oi, M_Warehouse wh
WHERE io.C_BPartner_ID = bp.C_BPartner_ID AND bpl.C_BPartner_ID = bp.C_BPartner_ID AND io.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND io.M_Warehouse_ID = wh.M_Warehouse_ID
",48932,0
344,45,1,0,"CREATE VIEW M_InOut_Header_vt AS
SELECT io.AD_Client_ID, io.AD_Org_ID, io.IsActive, io.Created, io.CreatedBy, io.Updated, io.UpdatedBy,
	dt.AD_Language,
    io.M_InOut_ID, io.IsSOTrx, io.DocumentNo, io.DocStatus,  io.C_DocType_ID,
	io.C_BPartner_ID, bp.Value AS BPValue,
	oi.C_Location_ID AS Org_Location_ID, oi.TaxID,
	io.M_Warehouse_ID,
	wh.C_Location_ID AS Warehouse_Location_ID,
    dt.PrintName AS DocumentType, dt.DocumentNote AS DocumentTypeNote,
    io.C_Order_ID, 
    io.MovementDate, io.MovementType,
    bpg.Name AS BPGreeting,
    bp.Name, bp.Name2,
    bpcg.Name AS BPContactGreeting,
    bpc.Title,
    NULLIF (bpc.Name, bp.Name) AS ContactName,
    bpl.C_Location_ID,
    bp.ReferenceNo,
    io.Description,
    io.POReference,
    io.DateOrdered,
    io.M_Shipper_ID, io.DeliveryRule, io.DeliveryViaRule, io.PriorityRule, bp.SendEMail
FROM M_InOut io, C_DocType_Trl dt, C_BPartner bp, C_Greeting_Trl bpg, C_BPartner_Location bpl, C_BPartner_Contact bpc, C_Greeting_Trl bpcg, AD_OrgInfo oi, M_Warehouse wh
WHERE io.C_BPartner_ID = bp.C_BPartner_ID AND bpl.C_BPartner_ID = bp.C_BPartner_ID AND io.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND io.M_Warehouse_ID = wh.M_Warehouse_ID AND io.C_BPartner_ID = bp.C_BPartner_ID AND io.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND io.M_Warehouse_ID = wh.M_Warehouse_ID
",48933,0
345,45,4,1,WHERE io.C_BPartner_ID = bp.C_BPartner_ID AND bpl.C_BPartner_ID = bp.C_BPartner_ID AND io.C_BPartner_Location_ID = bpl.C_BPartner_Location_ID AND io.M_Warehouse_ID = wh.M_Warehouse_ID,48934,0
