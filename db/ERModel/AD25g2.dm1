	Result = ""CREATE OR REPLACE TRIGGER "" & TriggerName
	Result = Result & "" BEFORE INSERT ON "" & CurrEntity.TableName & vbCrLf
	Result = Result & ""REFERENCING OLD AS OLD NEW AS NEW"" & vbCrLf
	Result = Result & ""FOR EACH ROW"" & vbCrLf
