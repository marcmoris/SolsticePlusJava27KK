1,46,1,1,"CREATE VIEW C_PaySelection_Remittance_vt AS
SELECT psl.AD_Client_ID, psl.AD_Org_ID, l.AD_Language, psl.C_PaySelection_ID, psl.C_PaySelectionLine_ID, psl.C_PaySelectionCheck_ID, psl.PaymentRule, psl.Line, psl.PayAmt, psl.DifferenceAmt, i.C_BPartner_ID, i.DocumentNo, i.DateInvoiced, i.GrandTotal, i.CopyFrom, l.AD_Language_ID, i.C_Invoice_ID, i.C_ConversionType_ID, psl.IsActive, psl.IsSOTrx, psl.Processed, psl.IsManual, i.GenerateTo, i.IsInDispute, i.IsApproved, i.IsDiscountPrinted, i.IsPaid, i.IsPayScheduleValid, i.IsPrinted, i.IsSelfService, i.IsTaxIncluded, i.IsTransferred, i.SendEMail, i.InvoiceCollectionType, i.MatchRequirement
FROM C_PaySelectionLine psl
  INNER JOIN C_Invoice i ON (psl.C_Invoice_ID=i.C_Invoice_ID), AD_Language l
WHERE psl.C_Invoice_ID = i.C_Invoice_ID
",48590,0
2,46,1,0,"CREATE VIEW C_PaySelection_Remittance_vt AS
