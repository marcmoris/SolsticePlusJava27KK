<script language="javascript">
   function saveForm()
   {
      document.mainForm.action.value = "save";
      document.mainForm.submit();
   }

   function updatedForm()
   {
      if(confirm("Voulez-vous vraiment recalculer ce relevé d'emploi?"))
      {
    	  document.mainForm.action.value = "updated";
	      document.mainForm.submit();
      }
   }

   function copyForm()
   {
      if(confirm("Voulez-vous vraiment copier ce relevé d'emploi?"))
      {
    	  document.mainForm.action.value = "copy";
	      document.mainForm.submit();
      }
   }

   function exportForm()
   {
	     document.mainForm.action.value = "export";
	     document.mainForm.submit();
   }
	   
   
   function deleteRoe()
   {
      if(confirm("Voulez-vous vraiment supprimer ce relevé d'emploi?"))
      {
         document.mainForm.action.value = "delete";
         document.mainForm.submit();
      }
   }
</script>
	</head>
	
