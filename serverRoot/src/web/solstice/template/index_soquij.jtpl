	<body>
		<div id="fond_site">
			<div id="wrapper">
			<div id="utilitaires">
						
			<ul>
					
					<li style="display:inline;"><a href="/solstice/soquij/fr/nous-joindre" >Nous joindre</a>&nbsp;<strong>|</strong>&nbsp;</li>
					<li style="display:inline;"><a href="/solstice/soquij/fr/english" >English</a>&nbsp;<strong>|</strong>&nbsp;</li>
				</ul>
	
					
					<span id="taille_police">
						<a href="#" id="augmenter"><img src="/solstice/soquij/images/ul/graphiques/police_plus.gif" width="9" height="9" alt="Agrandir la police" title="Agrandir la police" /></a>&nbsp; A &nbsp;<a href="#" id="diminuer"><img src="/solstice/soquij/images/ul/graphiques/police_moins.gif" width="9" height="9" alt="Diminuer la police" title="Diminuer la police" /></a>
					</span>
					
					<form method="get" class="form_recherche" action="/solstice/soquij/fr/recherche">						<input type="text" id="mots_cles" class="mots_cles" value="Recherche" />
						<input type="image" class="btn_recherche_rapide" src="/solstice/soquij/images/soquij2013/fleche_recherche_top.gif" />
					</form>
				</div>
				
				<div id="entete">
		<div id="slogan"><img src="/solstice/soquij/images/fr/titrages/slogan.gif" width="93" height="31" alt="Complice de vos succ&egrave;s" /></div>
<h1><a href="/solstice/soquij/fr"><img src="/solstice/soquij/images/soquij2013/logo2013.png" width="352" height="54" alt="Soci&eacute;t&eacute; qu&eacute;b&eacute;coise d'information juridique" title="Soci&eacute;t&eacute; qu&eacute;b&eacute;coise d'information juridique" /></a></h1>											
<ul id="navig_corpo">
			<li style="display:inline;"><a href="/solstice/soquij/fr">{CIE_NAME}</a></li>
	</ul>
	<!-- M&eacute;dias sociaux -->
	<div id="medias_sociaux">
		<a href="http://facebook.com/soquij" name="Facebook" target="_blank"><img src="/solstice/soquij/images/ul/icones/facebook.png" width="16" height="16" alt="Facebook. S'ouvrira dans une nouvelle fenêtre." title="Facebook" /></a>
		<a href="http://twitter.com/soquij" name="Twitter" target="_blank"><img src="/solstice/soquij/images/ul/icones/twitter.png" width="16" height="16" alt="Twitter. S'ouvrira dans une nouvelle fenêtre." title="Twitter" /></a>
		<a href="http://www.linkedin.com/company/soquij" name="LinkedIn" target="_blank"><img src="/solstice/soquij/images/ul/icones/linkedin.png" width="16" height="16" alt="LinkedIn. S'ouvrira dans une nouvelle fenêtre." title="LinkedIn" /></a>
	</div>
	<script type="text/javascript">
		$('#medias_sociaux a').click(function(){
			if (_gaq) {
				_gaq.push(['_trackEvent', 'Social', document.title.split(' - ')[0], $(this).attr('name')]);
			}
		});
	</script>

</div>
<div id="colonne_principale">
<div id="conteneur_colonnes">



