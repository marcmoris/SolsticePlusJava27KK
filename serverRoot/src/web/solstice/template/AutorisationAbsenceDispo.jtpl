<!-- BEGIN: main -->
<html>
<head>
<meta name="vs_targetSchema" content="http://schemas.microsoft.com/intellisense/ie5">
<link rel="stylesheet" type="text/css" href="styles/siq.css">

<title>{TITLE}</title>
<script type="text/javascript" src="scripts/comboBoxAutoComplete.js"></script>
<script language="JavaScript" src="scripts/ValidationTools.js" type=text/javascript></script>
<!-- CALENDRIER -->
  <script language="JavaScript" src="scripts/calendarheader.js" type=text/javascript></script>
  <script language="JavaScript" src="scripts/overlib_mini.js"></script>
<!-- FIN CALENDRIER -->

</head>
<body >
<div id="overDiv" style="Z-INDEX:1000; VISIBILITY:hidden; POSITION:absolute"></div>

<!-- HEADING: -->
<table width="900" align="center" border="0" cellspacing="2" cellpadding="0">

<tr>
	<td colspan="2" class="line"></td>
</tr>
<tr>
	<td colspan="2"><a href="/solstice/index.jsp" class="path">Menu principal</a> &middot;&gt; <a class="path" href="admconsult.jsp">{SUBTITLE}</a></td>
</tr>
<tr>
	<td colspan="2"><div class="pagetitle">{PAGETITLE}</div></td>
</tr>
<tr>
	<td colspan="2"></td>
</tr>
<tr>
	<td colspan="2">
    <form name="mainForm" method="post">
    <table width="100%" cellspacing="1" cellpadding="1" border="0">
    <tr>
        <td class="tdlabel">{LabelManager}</td>
    </tr>
    <tr>
        <td class="tdfield">{Manager}</td>
    </tr>
</table><br>
<table border="0" width="100%">
<tr>
<td class="tdlabel">{LabelApplicant}</td>
<td class="tdlabel">{LabelReason}</td>
<td class="tdlabel">{LabelStartDate}</td>
<td class="tdlabel">{LabelEndDate}</td>
<td class="tdlabel" align="right">{LabelTime}</td>
<td class="tdlabel">{LabelStatus}</td>
</tr>

<!-- BEGIN: line --> 
<tr>
<td class="{CELLCLASS}">{Applicant}</td>
<td class="{CELLCLASS}">{Reason} </td>
<td class="{CELLCLASS}">{StartDate}</td>
<td class="{CELLCLASS}">{EndDate}</td>
<td class="{CELLCLASS}" align="right" {MouseOver}>{Time}</td>
<td class="{CELLCLASS}">{Status}</td>
</tr>
<!-- END: line --> 


</table>
<br>
        
</tr>
{FOOTING}
</table>
</body>
</html>
<!-- END: main -->


