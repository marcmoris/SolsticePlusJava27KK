<!-- BEGIN: main -->
<html>
<!-- HEADING: -->
<link rel="stylesheet" type="text/css" media="all" href="../solstice.css">
 
      <script>
      function msg(message)
      {
         if(message!="")
            document.getElementById("info").innerHTML = message;
         else
            document.getElementById("info").innerHTML = "&nbsp;";
      }
      </script>

<body>
  
<!-- génération du tableau -->
<table width="900" align="center" border="0" cellspacing="2" cellpadding="0">
	<tr>
		<td colspan="2" class="line"></td>
	</tr>
	<tr>
		<td colspan="2"><a href="/solstice/index.jsp" class="path">Menu principal</a> </td>
	</tr>
	<tr>
		<td colspan="2"><div class="pagetitle">{TITLE}</div></td>
	</tr>
</table>

<center>
      <table border="0" cellpadding="0" cellspacing="0">
      <tr><td colspan="64">&nbsp;</td></tr>
      <tr><td colspan="64">
      <table width="100%">
         <tr>

            <td width="33%"><a href="{PreviousMonthLink}"><img src="../images/flg.gif" border="0"></a>&nbsp;&nbsp;<a href="{PreviousMonthLink}">{PreviousMonth}</a></td>
            <td width="33%" align="center"><b>{CurrentMonth}</b></td>
            <td width="33%" align="right"><a href="{NextMonthLink}">{NextMonth}</a>&nbsp;&nbsp;<a href="{NextMonthLink}"><img src="../images/fld.gif" border="0"></a></td>
         </tr>
      </table>
      </td></tr>
      <tr><td colspan="64">&nbsp;</td></tr>

     <tr>
         <td>&nbsp;</td>
<!-- BEGIN: head -->      
