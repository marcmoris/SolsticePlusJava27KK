<!-- BEGIN: main -->
<html>
<!-- HEADING: -->

	<table width="900" align="center" border="0" cellspacing="2" cellpadding="0">
	<tr>
		<td colspan="2" class="line"></td>
	</tr>
	<tr>
		<td colspan="2">
					<a href="/solstice/index.jsp" class="path">Menu principal</a> 
		</td>
	</tr>
	<tr>
		<td colspan="2"><div class="pagetitle">{TITLE}</div></td>
	</tr>

	<tr>
		<td colspan="2">
<script language="JavaScript">
		function search()
		{
			document.mainForm.action.value = 'search';
			document.mainForm.submit();
		}
</script> 

<form name="mainForm" method="post">
	<input type="hidden" name="action">
 	<table width="100%" border="0" cellspacing="1" cellpadding="1">
	<tr>
		<td class="tdlabel" colspan="3">Recherche </td>
	</tr>
	<tr>
		<td class="tdfield">{LabelYear} {ComboBoxYear} 		</td>
		<td class="tdfield">{LabelFrequency} {ComboBoxFrequency}</td>
		<td class="tdfield"><div align="right">	<input type="button" onClick="search();" value="Lancer la recherche"></td>
	</div>

	</tr>

    </table><br>
</td>
</tr>

<tr>
		<td colspan="2">

<p class="sectitle">R&eacute;sultats de la recherche</p>

<table width="100%" border="0" cellspacing="1" cellpadding="1">
<tr>
<td class="tdlabel" >{LabelPeriod}</td>
<td class="tdlabel" >{LabelStartDate}</td>
<td class="tdlabel" >{LabelEndDate}</td>
<td class="tdlabel" >{LabelPayDate}</td>
</tr>
<!-- BEGIN: line --> 
<tr>
<td class="{CELLCLASS}">{NAME}</td>
<td class="{CELLCLASS}">{STARTDATE}</td>
<td class="{CELLCLASS}">{ENDDATE}</td>
<td class="{CELLCLASS}">{PAYDATE}</td>
</tr>
<!-- END: line --> 
</table>

</form>
</td>
</tr>
<tr>
{FOOTING}
</tr>
</table>
</div>		
</div>	
</div>	
</body>
</html>

<!-- END: main -->