	<servlet>
		<servlet-name>JnlpDownloadServlet</servlet-name>
		<display-name>JnlpDownloadServlet</display-name>
		<description>JNLP Download Servlet</description>
		<servlet-class>jnlp.sample.servlet.JnlpDownloadServlet</servlet-class>
		<init-param>
			<param-name>logLevel</param-name>
			<param-value>INFORMATIONAL</param-value>
		</init-param>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet>
		<servlet-name>StatusInfo</servlet-name>
		<display-name>Server Status</display-name>
		<description>Compiere Server Status Info</description>
		<servlet-class>org.compiere.web.StatusInfo</servlet-class>
	</servlet>
	<servlet>
		<servlet-name>CompiereMonitor</servlet-name>
		<display-name>Compiere Monitor</display-name>
		<description>Compiere Server Monitor</description>
		<servlet-class>org.compiere.web.CompiereMonitor</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet>
		<servlet-name>login</servlet-name>
		<display-name>login</display-name>
		<description>La page de login</description>
		<servlet-class>solstice.custom.LoginServlet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet>
		<servlet-name>loginAdmin</servlet-name>
		<display-name>loginAdmin</display-name>
		<description>La page de login Administrateur</description>
		<servlet-class>solstice.custom.LoginAdministrator</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	
	<servlet>
		<servlet-name>index</servlet-name>
		<display-name>index</display-name>
		<description>La page index</description>
		<servlet-class>solstice.web.Index</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
	<servlet> 
		<servlet-name>listcredits</servlet-name>
		<display-name>listcredits</display-name>
		<description>List of credits by employee</description>
		<servlet-class>solstice.web.livretTemps.ListCredits</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>
