		<servlet-class>solstice.web.timesheet.timesheet</servlet-class>
		<load-on-startup>1</load-on-startup>
	</servlet>

	<servlet>
	   <servlet-name>loginReset</servlet-name>
	   <servlet-class>solstice.custom.LoginReset</servlet-class>
	</servlet>

	<servlet-mapping>
	   <servlet-name>loginReset</servlet-name>
	   <url-pattern>/loginReset</url-pattern>
	</servlet-mapping>

	<servlet-mapping>
	   <servlet-name>loginReset</servlet-name>
	   <url-pattern>/LoginManager/loginReset</url-pattern>
	</servlet-mapping>
	
	<servlet-mapping>
		<servlet-name>login</servlet-name>
		<url-pattern>/login.jsp</url-pattern>
