		<url-pattern>/compiereMonitor/*</url-pattern>
	</servlet-mapping> 
	<session-config> 
		<session-timeout>120</session-timeout> -->
	</session-config> 
	<mime-mapping>
		<extension>jar</extension>
		<mime-type>application/x-java-archive</mime-type>
	</mime-mapping>
	<mime-mapping>
		<extension>jardiff</extension>
		<mime-type>application/x-java-archive-diff</mime-type>
	</mime-mapping>
	<mime-mapping>
		<extension>jnlp</extension>
		<mime-type>application/x-java-jnlp-file</mime-type>
	</mime-mapping>
	<welcome-file-list>
<!--		<welcome-file>solstice_welcome.htm</welcome-file> -->
		<welcome-file>index.jsp</welcome-file>
	</welcome-file-list>
	<error-page>
		<error-code>401</error-code>
		<location>/solstice/error_401.jsp</location>
	</error-page>
	<error-page>
		<error-code>404</error-code>
		<location>/solstice/error.jsp</location>
	</error-page>
	<error-page>
		<error-code>403</error-code>
		<location>/solstice/error_403.jsp</location>
	</error-page>
	<error-page>
		<error-code>555</error-code>
		<location>/solstice/error_555.jsp</location>
	</error-page>
	<error-page>
		<exception-type>java.lang.Exception</exception-type>
		<location>/solstice/jspError.jsp</location>
	</error-page>
	
</web-app>

