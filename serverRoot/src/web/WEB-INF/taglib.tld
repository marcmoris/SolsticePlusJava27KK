<?xml version="1.0" encoding="ISO-8859-1" ?>
<!DOCTYPE taglib PUBLIC "-//Sun Microsystems, Inc.//DTD JSP Tag Library 1.1//EN" 
"http://java.sun.com/j2ee/dtds/web-jsptaglibrary_1_1.dtd">

<taglib>
   <tlibversion>3.0</tlibversion>    
   <jspversion>1.1</jspversion>    
   <shortname>mt</shortname>    
   <info>Définition des taglibs pour l'environnement de travail web de la SIQ. Ceux-ci réfère à des classes dans compiere.</info>
   
   <tag>
      <name>havingCondition</name>
      <tagclass>solstice.custom.HavingConditionTag</tagclass>
      <info>voir queryBuilder</info>
      
      <attribute>
         <name>id</name>
         <required>true</required>
      </attribute>
   </tag>
   
   <tag>
      <name>absenceCalendar</name>
      <tagclass>solstice.custom.AbsenceCalendarTag</tagclass>
      <info>Calendrier d'absence</info>
      
      <attribute>
         <name>employeeId</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      <attribute>
         <name>startDate</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      <attribute>
         <name>endDate</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
   </tag>
   
   
   <tag>
      <name>staticQueryCondition</name>
      <tagclass>solstice.custom.StaticQueryConditionTag</tagclass>
      <info>void queryBuilder</info>
   </tag>
      
   <tag>
      <name>securityCheck</name>
      <tagclass>solstice.custom.SecurityCheckTag</tagclass>
      <info>security</info>
      
      <attribute>
         <name>id</name>
         <required>true</required>
      </attribute>
   </tag>
   
   <tag>    
      <name>pageTag</name>        
      <tagclass>solstice.custom.PageTag</tagclass>      
      <info>
         Ce taglib crée un template de page selon le format de la SIQ. Il crée donc l'entête en utilisant des fichiers de template
         nommé "template/pageTag_start.html" et template/pageTag_end.html et en utilisant un fichier de menu nommé "menu.xml" compris
         dans le dossier ref (voir l'attribut).
      </info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>
      </attribute>
            
      <attribute>        
         <name>supportCalendar</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>validationClass</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>

      <attribute>
         <name>onLoad</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>
         <name>displayNavigation</name>
         <required>false</required>
         <rtexprvalue>false</rtexprvalue>
      </attribute>
   
   </tag>
   
   <tag>    
      <name>blankPage</name>        
      <tagclass>solstice.custom.BlankPageTag</tagclass>      
      <info>Ce taglib sert à créer une page vide.</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>supportCalendar</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
   </tag>
   
   <tag>    
      <name>comboBoxTag</name>
      <tagclass>solstice.custom.ComboBoxTag</tagclass>      
      <info>Un comboBox qui se remplit par SQL</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>className</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>formatMethod</name>            
         <required>false</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>allowNull</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>selectedValue</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>onChange</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
      <attribute>        
         <name>onBlur</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
      <attribute>        
         <name>onFocus</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
      <attribute>        
         <name>size</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
      <attribute>        
         <name>selectedValueMethod</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
      <attribute>        
         <name>checkConditionMethod</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
      <attribute>        
         <name>style</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
      <attribute>        
         <name>getPostValue</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>readOnly</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
   </tag>
   
   <tag>    
      <name>comboBoxVector</name>        
      <tagclass>solstice.custom.ComboBoxVectorTag</tagclass>      
      <info>Un comboBox qui se remplit par un vector de DictionaryEntry</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>parentId</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>attributeName</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>className</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>allowNull</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   </tag>
   
   <tag>    
      <name>radioButtonManager</name>        
      <tagclass>solstice.custom.RadioButtonManagerTag</tagclass>      
      <info>Controle le selectedValue de tous les radioButtonTag en dessous</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>parentId</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   </tag>
   
   <tag>    
      <name>hidden</name>        
      <tagclass>solstice.custom.HiddenTag</tagclass>      
      <info>hidden</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>parentId</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   </tag>
   
   <tag>    
      <name>radioButton</name>        
      <tagclass>solstice.custom.RadioButtonTag</tagclass>      
      <info>RadioButton</info>    
      
      <attribute>        
         <name>value</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>dynamicValue</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   </tag>
      
   <tag>    
      <name>customQuery</name>        
      <tagclass>solstice.custom.CustomQueryTag</tagclass>      
      <info>Une requête SQL</info>    
      
      <attribute>        
         <name>orderBy</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
   </tag>
   
   <tag>    
      <name>queryBuilder</name>        
      <tagclass>solstice.custom.QueryBuilderTag</tagclass>      
      <info>Une requête SQL</info>    
      
      <attribute>
         <name>orderBy</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      
      <attribute>
         <name>groupBy</name>
         <required>false</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      
      <attribute>
         <name>checkMethod</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
   
   </tag>
   
   <tag>    
      <name>checkVisible</name>        
      <tagclass>solstice.custom.CheckVisibleTag</tagclass>      
      <info>Une requête SQL</info>    
      
      <attribute>
         <name>checkMethod</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
      
   </tag>
   
   <tag>    
      <name>queryCondition</name>        
      <tagclass>solstice.custom.QueryConditionTag</tagclass>      
      <info>Une requête SQL</info>    
      
      <attribute>
         <name>id</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>
      </attribute>
   
   </tag>
   
   <tag>    
      <name>calendar</name>        
      <tagclass>solstice.custom.CalendarTag</tagclass>      
      <info>Crée un calendar</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>parentId</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>formName</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   
   </tag>
   
   <tag>    
      <name>classLinker</name>        
      <tagclass>solstice.custom.ClassLinkerTag</tagclass>      
      <info>Fait le lien entre le PO, les validations et les champs</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>poClass</name>            
         <required>true</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>
         <name>readOnly</name>            
         <required>false</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>
         <name>params</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   </tag>
   
   <tag>    
      <name>dynamicStructure</name>        
      <tagclass>solstice.custom.DynamicStructureTag</tagclass>      
      <info>Boucle selon une requète SQL</info>    
      
      <attribute>        
         <name>id</name>            
         <required>false</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>registerPrefix</name>            
         <required>false</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>registerValue</name>            
         <required>false</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>registerKey</name>            
         <required>false</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
   </tag>
   
   <tag>    
      <name>dynamicValue</name>        
      <tagclass>solstice.custom.DynamicValueTag</tagclass>      
      <info>Retourne la value</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>        
         <name>parentId</name>            
         <required>false</required>            
         <rtexprvalue>false</rtexprvalue>        
      </attribute>
      
      <attribute>
         <name>formatMethod</name>
         <required>false</required>
         <rtexprvalue>false</rtexprvalue>
      </attribute>
      
      <attribute>
         <name>nullValue</name>
         <required>false</required>
         <rtexprvalue>false</rtexprvalue>
      </attribute>
      
   </tag>
   
   <tag>    
      <name>loop</name>        
      <tagclass>solstice.custom.LoopTag</tagclass>      
      <info>Boucle 10x le body</info>    
      
      <attribute>        
         <name>iterations</name>            
         <required>true</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   </tag>
   
   <tag>    
      <name>textBox</name>        
      <tagclass>solstice.custom.TextBoxTag</tagclass>      
      <info>Controle le selectedValue de tous les radioButtonTag en dessous</info>    
      
      <attribute>        
         <name>id</name>            
         <required>true</required>            
