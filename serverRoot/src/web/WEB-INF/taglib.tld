   <tag>
      <name>listMultiColumn</name>
      <tagclass>solstice.custom.ListMultiColumnTag</tagclass>
      <info>ListBox avec plusieurs colonnes</info>
      
      <attribute>
         <name>id</name>
         <required>true</required>
         <rtexprvalue>false</rtexprvalue>        
      </attribute>

      <attribute>
         <name>columnsText</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>        
      </attribute>

      <attribute>
         <name>columnsWidth</name>
         <required>true</required>
         <rtexprvalue>true</rtexprvalue>        
      </attribute>

      <attribute>
         <name>height</name>
         <required>true</required>
      </attribute>

      <attribute>
         <name>initializeMethod</name>
         <required>true</required>
      </attribute>

      <attribute>
         <name>formName</name>
         <required>true</required>
      </attribute>

      <attribute>
         <name>javascriptMethod</name>
         <required>false</required>
      </attribute>

      <attribute>
         <name>cssLabel</name>
         <required>false</required>
      </attribute>

      <attribute>
         <name>cssField</name>
         <required>false</required>
      </attribute>

      <attribute>
         <name>cssSelected</name>
         <required>false</required>
      </attribute>

      <attribute>
         <name>autoReload</name>
         <required>false</required>
      </attribute>

   </tag>
   <tag>
      <name>body</name>
      <tagclass>solstice.custom.BodyTag</tagclass>
      <info>Body</info>
   </tag>

   <tag>
      <name>selectCase</name>
      <tagclass>solstice.custom.SelectCaseTag</tagclass>
      <info>voir queryBuilder</info>
      
      <attribute>
         <name>value</name>
         <required>false</required>
      </attribute>
 
       <attribute>
         <name>dynamicValue</name>
         <required>false</required>
      </attribute>
           
   </tag>

   <tag>
      <name>case</name>
      <tagclass>solstice.custom.CaseTag</tagclass>
      <info>voir queryBuilder</info>
      
      <attribute>
         <name>value</name>
         <required>false</required>
      </attribute>       
   </tag>
   
   <tag>
      <name>default</name>
      <tagclass>solstice.custom.DefaultTag</tagclass>
      <info>voir queryBuilder</info>     
   </tag>
   
   <tag>
      <name>roeCase</name>
      <tagclass>solstice.custom.ROECaseTag</tagclass>
      <info>voir queryBuilder</info> 
      
      <attribute>
         <name>caption</name>
         <required>true</required>
      </attribute>
      
      <attribute>
         <name>stared</name>
         <required>false</required>
      </attribute> 
      
      <attribute>
         <name>id</name>
         <required>false</required>
      </attribute>   
   </tag>
   
   <tag>
      <name>manipulableDeleteButton</name>
      <tagclass>solstice.custom.ManipulableDeleteButtonTag</tagclass>
      <info>voir queryBuilder</info> 
      
      <attribute>
         <name>type</name>
         <required>true</required>
      </attribute>
      
      <attribute>
         <name>src</name>
         <required>false</required>
      </attribute>   
      
      <attribute>
         <name>id</name>
         <required>false</required>
      </attribute>    
      
   </tag>
   
   <tag>
      <name>manipulableStructure</name>
      <tagclass>solstice.custom.ManipulableStructureTag</tagclass>
      <info>voir queryBuilder</info> 
      
      <attribute>
         <name>formName</name>
         <required>true</required>
      </attribute>
      
      <attribute>
         <name>initializationMethod</name>
         <required>true</required>
      </attribute>  
      
      <attribute>
         <name>id</name>
         <required>false</required>
      </attribute> 
  
      <attribute>
         <name>fields</name>
         <required>false</required>
      </attribute>  
        
   </tag>
   
      <tag>
      <name>erPage</name>
      <tagclass>solstice.custom.ERPageTag</tagclass>
      <info>voir queryBuilder</info> 
      
      <attribute>
         <name>validationClass</name>
         <required>true</required>
      </attribute>
      
      <attribute>
         <name>title</name>
         <required>false</required>
      </attribute>  
      
      <attribute>
         <name>styleSheet</name>
         <required>false</required>
      </attribute>   
        
      <attribute>
         <name>id</name>
         <required>false</required>
      </attribute>   
      
   </tag>
   
</taglib>
