      </attribute>
      
      <attribute>        
         <name>cols</name>            
         <required>false</required>            
         <rtexprvalue>true</rtexprvalue>        
      </attribute>
   </tag>
   
   <tag>    
      <name>checkBox</name>        
      <tagclass>solstice.custom.CheckBoxTag</tagclass>      
      <info>Controle le selectedValue de tous les radioButtonTag en dessous</info>    
      
      <attribute>        
