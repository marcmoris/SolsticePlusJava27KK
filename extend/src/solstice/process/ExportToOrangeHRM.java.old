    private StringBuffer addElement( String Element, String value )
    {
    	StringBuffer xmlStr = new StringBuffer( "");
    	//PgiUtil.convertHTMLString( 
    	if ( value != null)
    		xmlStr = xmlStr.append(  new StringBuffer( "<" + Element + ">" + value  + "</" + Element + ">" ));
    	else
    		xmlStr = xmlStr.append(  new StringBuffer( "<" + Element + ">" + "</" + Element + ">" ));
    	
    	return xmlStr;
    }


    private void sendPayPeriod()
    {
    	StringBuffer xmlStr = new StringBuffer( "<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>");
    	
    	String sql = "Select * from P_Period" ;
    	PreparedStatement stmt = DB.prepareStatement(sql, null);
        try
        {
        	P_Period Period = null;
        	
			String EXPORT_LOC =  PgiUtil.getSolsticeParameter(getCtx(), "PayStubPDFPath");

			xmlStr = xmlStr.append( "<Periods>");

	        ResultSet rs = stmt.executeQuery();
	        while(rs.next())
	        {
				xmlStr = xmlStr.append( "<Period>");

	        	Period = new P_Period( getCtx(), rs, null);

				xmlStr = xmlStr.append(  addElement("id" , String.valueOf( Period.getP_Period_ID() ) ) );
				xmlStr = xmlStr.append( addElement("Start_Date" , String.valueOf(Period.getStartDate() )).substring(0,10) ) ;
				xmlStr = xmlStr.append( addElement("End_Date" ,  String.valueOf(Period.getEndDate() ).substring(0,10) )) ;

				xmlStr = xmlStr.append( addElement("Close_Date" , "" )) ;
				xmlStr = xmlStr.append( addElement("Check_Date" , "" )) ;
				xmlStr = xmlStr.append( addElement("timesheet_aproval_due_date" ,  "" )) ;

				xmlStr = xmlStr.append( "</Period>");
	        }

	        xmlStr = xmlStr.append( "</Periods>");

	        rs.close();
	        stmt.close();

		
			String xmlFileName =  "hs_hr_pay_period.xml" ;
    		File xmlFile = new File( EXPORT_LOC + xmlFileName );
    		FileOutputStream out = new FileOutputStream(xmlFile, false);
    		PrintStream p = new PrintStream(out); 
    		p.println(xmlStr);
    		p.close();
    		
			SendFileFTP( EXPORT_LOC,  xmlFileName  );
        }
        catch (Exception e)
        {
        	log.log (Level.SEVERE,"ExportToOrangeHrm - " + sql, e);
        }

    	
    }
    
    
    
    private void sendWorkPlace()
    {
    	StringBuffer xmlStr = new StringBuffer( "<?xml version=\"1.0\" encoding=\"ISO-8859-1\"?>");
    	
    	String sql = "Select * from P_Workplace" ;
    	PreparedStatement stmt = DB.prepareStatement(sql, null);
        try
        {
        	P_Workplace Workplace = null;
        	
			String EXPORT_LOC =  PgiUtil.getSolsticeParameter(getCtx(), "PayStubPDFPath");

			xmlStr = xmlStr.append( "<Workplaces>");

	        ResultSet rs = stmt.executeQuery();
	        while(rs.next())
	        {
				xmlStr = xmlStr.append( "<Workplace>");

	        	Workplace = new P_Workplace( getCtx(), rs, null);
				MLocation Location = MLocation.get( getCtx(), Workplace.getC_Location_ID(), null);
				MRegion Region = new MRegion( getCtx(), Location.getC_Region_ID(), null);
				MCountry Country = new MCountry( getCtx(), Location.getC_Country_ID(), null);

				xmlStr = xmlStr.append(  addElement("id" , String.valueOf( Workplace.getP_Workplace_ID() ) ) );
				xmlStr = xmlStr.append( addElement("Name" , Workplace.getValue() + ' ' + Workplace.getName() )) ;
				xmlStr = xmlStr.append( addElement("country_code" , Country.getCountryCode() )) ;

				xmlStr = xmlStr.append( addElement("city" , Location.getCity() )) ;
				xmlStr = xmlStr.append( addElement("province" , Region.getDescription() )) ;
				xmlStr = xmlStr.append( addElement("zip_code" , Location.getPostal() )) ;

				xmlStr = xmlStr.append( addElement("phone" , Workplace.getPhone() )) ;
				xmlStr = xmlStr.append( addElement("fax" , "" )) ;
				xmlStr = xmlStr.append( addElement("notes" , "" )) ;

				xmlStr = xmlStr.append( "</Workplace>");
	        }

	        xmlStr = xmlStr.append( "</Workplaces>");

	        rs.close();
	        stmt.close();
			
			String xmlFileName =  "ohrm_location.xml" ;
    		File xmlFile = new File( EXPORT_LOC + xmlFileName );
    		FileOutputStream out = new FileOutputStream(xmlFile, false);
    		PrintStream p = new PrintStream(out); 
    		p.println(xmlStr);
    		p.close();
    		
			SendFileFTP( EXPORT_LOC,  xmlFileName  );
        }
        catch (Exception e)
        {
        	log.log (Level.SEVERE,"ExportToOrangeHrm - " + sql, e);
        }

    	
    }

