	private static void generateAbsenceStatus()
	{
		String[] values = new String[] {"INIT", "ATTE", "APPR", "REFU", "SIGN", "DSUP", "TRSF", "SIGD", "DELE"};
		String[] names = new String[] {"Initiale", "En attente d'approbation", "Approuvée partiellement",
		        "Refusée", "Approuvée", "En demande de suppression", "Approuvée et transférée au livret de temps",
		        "Approuvée par délégué", "Supprimée"};

		for(int i = 0; i < values.length; i++)
		{
		    System.out.println(values[i] + ":" + names[i]);
			P_Absence_Status absenceStatus = new P_Absence_Status(Env.getCtx(), -1, null);
		    absenceStatus.setValue(values[i]);
		    absenceStatus.setName(names[i]);
		    absenceStatus.save();
		}
		
		System.out.println("Well done");
	}
	
	private static int getCount(String periodName)
	{
	    int count = 0;
	    String sql 
	    = "select isnull(count(1), 0)"
	        + " from P_Payment"
	        + " where exists ("
	        + "   select 1"
	        + "   from P_Period"
	        + "   where Name = '" + periodName + "'"
	        + "   and P_Period_ID = P_Payment.P_Period_ID"
	        + " )"
	        + " and exists ("
	        + "   select 1"
	        + "   from P_Time_Sheet"
	        + "   where P_Payment_ID = P_Payment.P_Payment_ID"
	        + "   and SheetType = 'Regular'"
	        + " )"
//	        + " and p_employee_id = 1002818"
	        ;
	    
	    try
	    {
	        PreparedStatement stmt = DB.prepareStatement(sql, null);
	        ResultSet rs = stmt.executeQuery();
	        
	        if(rs.next())
	        {
	            count = rs.getInt(1);
	        }
	        
	        rs.close();
	        stmt.close();
	    }
	    catch (SQLException e)
	    {
	        e.printStackTrace(System.out);
	    }
	    return count;
	}

	private static void generateStatementEarning2()
	{
	    String sql = "select P_Payment_ID"
	        + " from P_Payment WHERE p_period_id = 1001728"
	        + " and p_employee_id = 1002475"
	        ;
	    
	    try
	    {
	        PreparedStatement stmt = DB.prepareStatement(sql, null);
	        ResultSet rs = stmt.executeQuery();
	        
	        int i = 1;
	        while(rs.next())
	        {
	            System.out.println("Génération de l'avis de dépot pour le paiment " + rs.getInt("P_Payment_ID") + " (" + (i++) + "/" + 1 + ")");
	            P_Payment payment = new P_Payment(Env.getCtx(), rs.getInt("P_Payment_ID"), null);
	            payment.createStatementEarning();
	        }
	        
	        rs.close();
	        stmt.close();
	    }
	    catch (SQLException e)
	    {
	        e.printStackTrace(System.out);
	    }
	}
	
	private static void generateStatementEarning(String periodName)
	{
	    int count = getCount(periodName);
	    String sql 
	    = "select P_Payment_ID"
	        + " from P_Payment"
	        + " where exists ("
	        + "   select 1"
	        + "   from P_Period"
	        + "   where Name = '" + periodName + "'"
	        + "   and P_Period_ID = P_Payment.P_Period_ID"
	        + " )"
	        + " and exists ("
	        + "   select 1"
	        + "   from P_Time_Sheet"
	        + "   where P_Payment_ID = P_Payment.P_Payment_ID"
	        + "   and SheetType = 'Regular'"
	        + " )"
//	        + " and p_employee_id = 1002818"
	        ;
	    
	    try
	    {
	        PreparedStatement stmt = DB.prepareStatement(sql, null);
	        ResultSet rs = stmt.executeQuery();
	        
	        int i = 1;
	        while(rs.next())
	        {
	            System.out.println("Génération de l'avis de dépot pour le paiment " + rs.getInt("P_Payment_ID") + " (" + (i++) + "/" + count + ")");
	            P_Payment payment = new P_Payment(Env.getCtx(), rs.getInt("P_Payment_ID"), null);
	            payment.createStatementEarning();
	        }
	        
	        rs.close();
	        stmt.close();
	    }
	    catch (SQLException e)
	    {
	        e.printStackTrace(System.out);
	    }
	}
}
